<%# An item's value as a field, in its frame on the site's page: saving confirms it as the saver's. %>
<turbo-frame id="<%= dom_id(@item, :value) %>">
  <%= form_with model: @item, url: website_checklist_site_item_path(@site, @item), scope: :item, class: "website-checklist-inline-form", data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
    <%= form.text_field :value, class: "input full-width", autofocus: true, autocomplete: "off", aria: { label: "Value of #{@item.title}" } %>
    <button type="submit" class="btn btn--link txt-small" data-form-target="submit">Save</button>
    <%= link_to "Cancel", website_checklist_site_path(@site), class: "btn btn--plain txt-small", data: { form_target: "cancel" } %>
  <% end %>
  <% if @item.detected? && @site.cms_linked? %>
    <p class="txt-x-small txt-subtle margin-none">The CMS says: <%= @item.detected_value.presence || "nothing" %>. Saving here doesn't change the CMS.</p>
  <% end %>
  <% if @item.errors.any? %>
    <p class="website-checklist-problem txt-x-small margin-none"><%= @item.errors.full_messages.to_sentence %></p>
  <% end %>
</turbo-frame>
