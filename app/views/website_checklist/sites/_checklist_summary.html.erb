<%# locals: (site:, summary:) %>
<%# The site's checklist count under its name, replaced when an item is saved. %>
<span id="<%= dom_id(site, :checklist_summary) %>" class="record-meta">
  <%= website_summary_tag site, summary %>
  <% if (attention = website_attention_text(site, summary)) %>
    <span><%= attention %></span>
  <% end %>
</span>
