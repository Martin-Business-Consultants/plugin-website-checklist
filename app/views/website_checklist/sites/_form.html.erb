<%# locals: (site:) %>
<%= render "layouts/shared/errors", record: site %>

<%= form_with model: site, url: site.new_record? ? website_checklist_sites_path : website_checklist_site_path(site), scope: :site, class: "record-form", data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
  <% if site.new_record? %>
    <label class="record-form__field">
      <span class="record-form__label"><%= term(:client) %></span>
      <%= form.select :client_id, website_client_options, { include_blank: "Choose…" }, class: "input input--select full-width", required: true %>
    </label>
  <% end %>

  <div class="record-form__row">
    <label class="record-form__field">
      <span class="record-form__label">Name</span>
      <%= form.text_field :name, class: "input full-width", autofocus: site.new_record?, autocomplete: "off", placeholder: "Main site", required: true %>
    </label>
    <label class="record-form__field">
      <span class="record-form__label">Address</span>
      <%= form.url_field :url, class: "input full-width", autocomplete: "off", placeholder: "https://example.com" %>
    </label>
  </div>

  <div class="record-form__footer">
    <%= link_to "Cancel", site.new_record? ? website_checklist_sites_path : website_checklist_site_path(site), class: "btn btn--plain record-form__cancel", data: { form_target: "cancel" } %>
    <button type="submit" class="btn btn--link" data-form-target="submit">
      <span><%= site.new_record? ? "Add website" : "Save changes" %></span>
    </button>
  </div>
<% end %>
