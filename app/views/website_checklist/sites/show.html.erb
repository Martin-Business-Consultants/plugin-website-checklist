<% @page_title = @site.name %>
<% summary = @site.summary %>

<% content_for :header do %>
  <%= parent_page "Websites", website_checklist_sites_path %>
<% end %>

<%# The checklist on the left, the picked item on the right: picking one reloads only this frame,
    so the page stays where it was scrolled. %>
<turbo-frame id="website_checklist" target="_top">
  <section class="settings settings--split website-checklist-split">
    <div class="settings__panel panel shadow txt-align-start">
      <div class="page-heading">
        <h1 class="page-title"><%= @page_title %></h1>
        <div class="page-heading__actions">
          <% if WebsiteChecklist::Scan.ai_available_for?(@site) %>
            <div class="display-contents" data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
              <button type="button" class="btn btn--circle-mobile" data-action="dialog#open">
                <%= icon_tag "ai" %>
                <span>AI audit</span>
              </button>
              <dialog class="dialog panel website-checklist-sheet" data-dialog-target="dialog" aria-label="AI audit">
                <div class="website-checklist-sheet__bar">
                  <h2 class="dialog__title">AI audit · <%= @site.name %></h2>
                  <%= link_to "Done", website_checklist_site_path(@site, item: @item&.id), class: "btn txt-small", data: { turbo_frame: "_top" } %>
                </div>
                <turbo-frame id="website_checklist_scan" src="<%= website_checklist_site_scans_path(@site) %>" loading="lazy">
                  <p class="txt-small txt-subtle margin-none">Loading…</p>
                </turbo-frame>
              </dialog>
            </div>
          <% end %>
          <%= link_to website_checklist_audits_path(site_id: @site.id), class: "btn btn--circle-mobile", data: { turbo_frame: "_top" } do %>
            <%= icon_tag "history" %>
            <span>History</span>
          <% end %>
          <% if can?(:manage_websites) %>
            <%= link_to edit_website_checklist_site_path(@site), class: "btn btn--circle-mobile", data: { keys: "e" } do %>
              <%= icon_tag "pencil" %>
              <span>Edit</span>
              <kbd class="hide-on-touch">E</kbd>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="record-meta txt-small">
        <%= render "website_checklist/sites/checklist_summary", site: @site, summary: summary %>
        <%= link_to @site.client.name, client_path(@site.client, tab: "plugin-website_checklist"), class: "txt-link" %>
        <% if @site.url %>
          <%= link_to @site.host, @site.url, class: "txt-link", target: "_blank", rel: "noopener" %>
        <% end %>
      </div>

      <% steps = website_step_numbers(@items) %>

      <% website_item_groups(@items).each do |group, items| %>
        <%# herb:key group %>
        <section class="settings__section flex flex-column gap-half">
          <header class="website-checklist-group__header">
            <h2 class="divider"><%= group %></h2>
            <%= render "website_checklist/sites/group_summary", site: @site, group: group, items: items %>
          </header>
          <nav class="scope-nav" aria-label="<%= group %>">
            <% items.each do |item| %>
              <%# herb:key item.id %>
              <%= render "website_checklist/sites/item_link", item: item, site: @site, step: steps[item], current: item == @item %>
            <% end %>
          </nav>
        </section>
      <% end %>

      <div class="section-actions">
        <details class="website-checklist-add">
          <summary class="btn txt-small"><%= icon_tag "add" %> <span>Add an item</span></summary>
          <%= form_with url: website_checklist_site_items_path(@site), scope: :item, class: "flex flex-column gap-half txt-small" do |form| %>
            <%= form.text_field :title, class: "input full-width", placeholder: "What to check", required: true, maxlength: 200, autocomplete: "off", autofocus: true, aria: { label: "What to check" } %>
            <%= form.text_field :value, class: "input full-width", placeholder: "Its value, if you know it", autocomplete: "off", aria: { label: "Value" } %>
            <div>
              <button type="submit" class="btn btn--link txt-small">Add</button>
            </div>
          <% end %>
        </details>
      </div>
    </div>

    <div id="website_checklist_detail" class="settings__panel panel shadow txt-align-start website-checklist-detail">
      <% if @item %>
        <%= render "website_checklist/sites/item", item: @item, site: @site, step: steps[@item], total: @items.size, next_item: steps.keys[steps[@item]] %>
      <% else %>
        <p class="txt-small txt-subtle margin-none">Pick an item on the left to see and change it.</p>
      <% end %>
    </div>
  </section>
</turbo-frame>
