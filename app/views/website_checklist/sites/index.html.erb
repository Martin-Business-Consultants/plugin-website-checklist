<% @page_title = "Websites" %>

<% content_for :index_filters do %>
  <%= render "layouts/shared/quick_filter", title: "Show…", param: :show, current: @show,
        options: [ [ "Needs attention (#{@counts["attention"]})", "attention" ], [ "All (#{@counts["all"]})", "all" ] ] %>
  <%= link_to website_checklist_audits_path, class: "btn txt-small" do %>
    <%= icon_tag "history" %> <span>History</span>
  <% end %>
<% end %>
<%= render "layouts/shared/index_toolbar", new_text: (can?(:manage_websites) ? "Add a website" : nil),
      new_path: (new_website_checklist_site_path(client_id: @client&.id) if can?(:manage_websites)) %>

<section class="panel shadow center index-table">
  <table class="data-table">
    <thead>
      <tr><th>Website</th><th><%= term(:client) %></th><th>Checklist</th><th>To do</th><th></th></tr>
    </thead>
    <tbody>
      <% @sites.each do |site| %>
        <%# herb:key site.id %>
        <% summary = site.summary %>
        <tr data-filter-target="item">
          <td>
            <%= link_to website_checklist_site_path(site), class: "txt-ink" do %>
              <strong><%= site.name %></strong>
              <div class="txt-x-small txt-subtle overflow-ellipsis"><%= site.host %></div>
            <% end %>
          </td>
          <td><%= link_to site.client.name, client_path(site.client, tab: "plugin-website_checklist"), class: "txt-ink" %></td>
          <td><%= website_summary_tag site, summary %></td>
          <td class="txt-small"><%= website_attention_text(site, summary) || "Nothing" %></td>
          <%= render "layouts/shared/row_actions", name: site.name,
                edit_path: (edit_website_checklist_site_path(site) if can?(:manage_websites)),
                delete_path: (website_checklist_site_path(site) if can?(:manage_websites)),
                delete_message: "This forgets the website and its checklist." %>
        </tr>
      <% end %>
      <% if @sites.empty? %>
        <tr>
          <td colspan="5" class="txt-subtle txt-small">
            <% if @show == "attention" && @counts["all"].positive? %>
              Every website is live, every step confirmed. <%= link_to "Show all", website_checklist_sites_path(show: "all", client_id: @client&.id), class: "txt-link" %>
            <% else %>
              No websites yet. Add a <%= term(:client).downcase %>'s website to gather what it needs to go live, step by step.
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
