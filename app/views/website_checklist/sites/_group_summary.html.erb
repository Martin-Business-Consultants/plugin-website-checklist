<%# locals: (site:, group:, items:) %>
<%# A group's count on its accordion, replaced when one of its items is saved. %>
<span id="<%= dom_id(site, "group_#{group.parameterize(separator: "_")}") %>" class="<%= class_names("txt-x-small", "txt-subtle": !website_group_done?(items), "website-checklist-group-done": website_group_done?(items)) %>"><% if website_group_done?(items) %><%= icon_tag "check" %> <% end %><%= website_group_summary(items) %></span>
